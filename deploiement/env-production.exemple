# Fichier .env du SERVEUR (ifpm.lamajestueuse.com).
# À copier en .env à la racine de l'application, puis à compléter.
# Il n'est jamais envoyé par le pipeline : il reste sur le serveur.

APP_NAME="IFPM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ifpm.lamajestueuse.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Journaux : un fichier par jour, seulement les erreurs.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Le site est en HTTPS : le cookie de session ne doit pas circuler en clair.
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database

# Relais d'envoi : les mêmes réglages que le portail du groupe.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@lamajestueuse.com"
MAIL_FROM_NAME="IFPM"

# Identite de l'etablissement. Le code est commun a IUM, IFPM et GSBM :
# sans ces valeurs, le site s'affiche sous celle d'IUM, qui est la valeur
# par defaut du code.
ETABLISSEMENT_SIGLE="IFPM NDAZOA"
ETABLISSEMENT_NOM="Institut de Formation Professionnelle La Majestueuse"
ETABLISSEMENT_SLOGAN="Forgeons votre avenir métier."
ETABLISSEMENT_ADRESSE="Ndazoa, 7 km de Mbankomo, route Yaoundé-Douala (près de la station Green Oil)"
ETABLISSEMENT_TELEPHONE="+237 695 045 057 / 655 341 939 / 672 975 394"
ETABLISSEMENT_EMAIL=info@ifpm-ndazoa.com
ETABLISSEMENT_DOMAINE=ifpm-ndazoa.com
ETABLISSEMENT_LOGO=ifpm.png
LIBELLE_CYCLE="Formation"
LIBELLE_CYCLE_AIDE="Formation qualifiante"
LIBELLE_DEPARTEMENT="Domaines"
LIBELLE_DEPARTEMENT_AIDE="Bâtiment, Mode, Numérique..."
LIBELLE_FILIERE="Métiers"
LIBELLE_FILIERE_AIDE="Métiers enseignés"
LIBELLE_SPECIALITE="Parcours"
LIBELLE_SPECIALITE_AIDE="Métier et durée"
LIBELLE_UE="Modules"
LIBELLE_UE_AIDE="Modules de formation"
LIBELLE_ETUDIANTS="Apprenants"
