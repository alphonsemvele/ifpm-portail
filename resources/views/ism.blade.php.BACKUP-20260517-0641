    <script>
        AOS.init({ duration: 800, once: true });

        // Modal d'inscription
        document.querySelectorAll('.register-btn').forEach(button => {
            button.addEventListener('click', function (e) {
                e.preventDefault();
                document.getElementById('ifpm-filiere').value = this.getAttribute('data-filiere');
                document.getElementById('ifpmRegisterModal').classList.add('active');
            });
        });

        document.querySelector('.ifpm-modal-close').addEventListener('click', function () {
            document.getElementById('ifpmRegisterModal').classList.remove('active');
        });

        document.getElementById('ifpmRegisterModal').addEventListener('click', function (event) {
            if (event.target === this) this.classList.remove('active');
        });

        // Preloader
        window.addEventListener('load', function () {
            const preloader = document.getElementById('ifpmPreloader');
            preloader.classList.add('ifpm-preloader-fade');
            setTimeout(() => { preloader.style.display = 'none'; }, 800);
        });

        // Smooth scroll
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    e.preventDefault();
                    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });
    </script>
